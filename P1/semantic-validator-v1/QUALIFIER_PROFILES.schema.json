{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiaeao:cube:p1:qualifier-profiles:1",
  "title": "P1.4 optional scoped descriptive qualifier profiles; never runtime authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "reference_version", "profile_id", "scope", "origin", "witness_refs", "qualifiers"],
  "properties": {
    "format": {"const": "aiaeao.cube.qualifier-profiles/1"},
    "reference_version": {"const": "v9.4"},
    "profile_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "origin": {"enum": ["illustrative_fixture", "external_declaration_unverified"]},
    "witness_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "qualifiers": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/qualifierProfile"}}
  },
  "$defs": {
    "qualifierProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_ref", "coordinate", "required_parameters", "allowed_parameters", "allowed_values", "requires_witness"],
      "properties": {
        "profile_ref": {"type": "string", "minLength": 1},
        "coordinate": {"enum": ["T", "F", "M", "O"]},
        "required_parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
        "allowed_parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
        "allowed_values": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
        "requires_witness": {"type": "boolean"}
      }
    }
  }
}
