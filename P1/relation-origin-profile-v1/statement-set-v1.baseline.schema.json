{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiaeao:cube:p1:statement-set:1",
  "title": "Statement set /1 shape (VP-10 0.11.0 SS-1…SS-3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "set_id",
    "context_id",
    "referents",
    "statements",
    "witness_ref"
  ],
  "properties": {
    "format": {
      "const": "aiaeao.cube.statement-set/1"
    },
    "set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "referents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "witness_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "subject",
        "predicate_id",
        "object"
      ],
      "properties": {
        "statement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}
