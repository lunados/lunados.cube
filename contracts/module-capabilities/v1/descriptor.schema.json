{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiaeao.local/contracts/module-capabilities/v1/descriptor.schema.json",
  "title": "AIAEAO documentary module capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "module", "sources", "capabilities", "exclusions"],
  "properties": {
    "format": {"const": "aiaeao.module-capabilities/1"},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/nonempty"},
        "owner": {"$ref": "#/$defs/nonempty"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact", "version", "owner", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "artifact": {"$ref": "#/$defs/nonempty"},
          "version": {"$ref": "#/$defs/nonempty"},
          "owner": {"$ref": "#/$defs/nonempty"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "source_ids", "inputs", "outputs", "exclusions"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "version": {"$ref": "#/$defs/nonempty"},
          "status": {"enum": ["implemented", "candidate", "unknown"]},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "implementation_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "inputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
          "outputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
          "exclusions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
          "v2_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract", "source_id", "capability_id", "capability_version"],
            "properties": {
              "contract": {"const": "aiaeao-module-contract/v2"},
              "source_id": {"$ref": "#/$defs/id"},
              "capability_id": {"enum": ["structured-inspection", "artifact-observation"]},
              "capability_version": {"const": "v1"}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "implemented"}}, "required": ["status"]}, "then": {"required": ["implementation_evidence"]}},
          {"if": {"properties": {"status": {"enum": ["candidate", "unknown"]}}, "required": ["status"]}, "then": {"not": {"required": ["implementation_evidence"]}}}
        ]
      }
    },
    "exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "description"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/nonempty"},
        "format_ref": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
