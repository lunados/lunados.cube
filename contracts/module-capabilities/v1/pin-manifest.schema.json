{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiaeao.local/contracts/module-capabilities/v1/pin-manifest.schema.json",
  "title": "Explicit local inputs for module capability verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "descriptors"],
  "properties": {
    "format": {"const": "aiaeao.module-capabilities.pin-manifest/1"},
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ref", "sha256", "sources"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]*$"},
                "path": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
