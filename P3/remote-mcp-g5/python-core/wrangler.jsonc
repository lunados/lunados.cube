{
  "name": "aiaeao-cube-g5-core",
  "main": "entry.py",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 30000
  },
  "find_additional_modules": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "P3/adapters/mcp-local/aiaeao_mcp_local/neighbors.json",
        "P3/adapters/mcp-local/p0_snapshot/*.json",
        "P3/adapters/mcp-local/p0_snapshot/**/*.json",
        "P3/adapters/mcp-local/p0_snapshot/*.md",
        "P3/adapters/mcp-local/p0_snapshot/**/*.md",
        "P3/adapters/mcp-local/p0_snapshot/*.ebnf",
        "P3/adapters/mcp-local/p0_snapshot/**/*.ebnf",
        "P1/instantiation-profile-v1/instantiation_reference_v1.json",
        "P1/scope-nesting-profile-v1/instantiation_reference_v2.json",
        "P1/migration-profile-v1/cube_p110/profiles/*.json",
        "P1/migration-methods-v1/cube_p111/profiles/*.json",
        "P1/semantic-validator-v1/baseline/*.json",
        "P1/semantic-validator-v1/baseline/**/*.json",
        "P1/semantic-validator-v1/baseline/*.md",
        "P1/semantic-validator-v1/baseline/**/*.md",
        "P1/semantic-validator-v1/baseline/*.ebnf",
        "P1/semantic-validator-v1/baseline/**/*.ebnf",
        "P1/semantic-validator-v1/baseline/*.txt",
        "P1/semantic-validator-v1/baseline/**/*.txt",
        "P2/visual-printer-2d-lab/reference/*.json",
        "P2/visual-printer-2d-lab/reference/**/*.json",
        "P2/visual-printer-2d-lab/reference/*.md",
        "P2/visual-printer-2d-lab/reference/**/*.md",
        "P2/visual-printer-2d-lab/reference/*.ebnf",
        "P2/visual-printer-2d-lab/reference/**/*.ebnf",
        "P2/visual-printer-2d-lab/reference/*.txt",
        "P2/visual-printer-2d-lab/reference/**/*.txt",
        "P2/visual-printer-migration-v1/vpmigration/locales/*.json",
        "P2/visual-printer-cells-v1/vpcells/locales/*.json",
        "P2/visual-printer-instances-v1/vpinstances/locales/*.json",
        "P2/visual-printer-axes-v1/vpaxes/locales/*.json",
        "P2/visual-printer-landscape-v1/vplandscape/locales/*.json"
      ]
    }
  ]
}
