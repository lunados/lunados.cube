{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiaeao:cube:g3-cross-domain-evidence:1",
  "title": "G3 independent cross-domain evidence (read-only test artifact)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "scenario", "trace_status", "p0", "p1", "p2", "cross_domain_link", "acg_to_vp03_mapping", "p2_bundle_provision", "source_truth", "authority", "admission", "note"],
  "properties": {
    "format": {"const": "aiaeao.cube.g3-cross-domain-evidence/1"},
    "scenario": {"enum": ["declared_fixture", "p1_fail_p2_valid", "p1_unresolved_p2_valid"]},
    "trace_status": {"const": "COMPLETE"},
    "p0": {
      "type": "object", "required": ["domain", "status", "uri", "reference_version", "index_sha256", "content_sha256", "bytes_read", "pages_read", "source_warrant", "content_truth"],
      "properties": {
        "domain": {"const": "P0"}, "status": {"const": "INTEGRITY_CHECKED"},
        "uri": {"type": "string"}, "reference_version": {"const": "v9.4"},
        "index_sha256": {"$ref": "#/$defs/sha256"}, "snapshot_lock_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "bytes_read": {"type": "integer", "minimum": 1},
        "pages_read": {"type": "integer", "minimum": 1},
        "source_warrant": {"const": "canonical_documentary_reference_only"},
        "content_truth": {"const": "NOT_EVALUATED"}
      }
    },
    "p1": {
      "type": "object", "required": ["domain", "status", "profile", "input_sha256", "checks", "source_warrant", "epistemic_warrant", "current_authority", "canonical_admission"],
      "properties": {
        "domain": {"const": "P1"}, "status": {"enum": ["PASS", "FAIL", "UNRESOLVED"]},
        "profile": {"const": "P1-VC/1.0.0"}, "input_sha256": {"$ref": "#/$defs/sha256"},
        "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
        "source_warrant": {"const": "declared_unverified"},
        "epistemic_warrant": {"const": "NOT_EVALUATED"},
        "current_authority": {"const": "NOT_EVALUATED"},
        "canonical_admission": {"const": "NOT_EVALUATED"}
      }
    },
    "p2": {
      "type": "object", "required": ["domain", "status", "profile", "view", "lens", "granularity", "svg_sha256", "svg_bytes", "source_bundle_sha256", "source_status", "decision", "epistemic_warrant", "current_authority", "canonical_admission"],
      "properties": {
        "domain": {"const": "P2"}, "status": {"const": "PASS"},
        "profile": {"const": "P2-VP/1.0.0-rc1"},
        "view": {"enum": ["cube.flow", "cube.diagramm", "cube.tree"]},
        "lens": {"enum": ["cube.lens.semantics", "cube.lens.provenance", "cube.lens.execution", "cube.lens.governance", "cube.lens.epistemology"]},
        "granularity": {"enum": ["overview", "standard", "detail"]},
        "svg_sha256": {"$ref": "#/$defs/sha256"},
        "svg_bytes": {"type": "integer", "minimum": 1},
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "source_status": {"const": "declared_unverified"},
        "decision": {"type": "string"},
        "epistemic_warrant": {"const": "NOT_EVALUATED"},
        "current_authority": {"const": "NOT_EVALUATED"},
        "canonical_admission": {"const": "NOT_EVALUATED"}
      }
    },
    "cross_domain_link": {"const": "NOT_ESTABLISHED"},
    "acg_to_vp03_mapping": {"const": "NOT_PERFORMED"},
    "p2_bundle_provision": {"const": "separately_supplied_explicit_vp03_declaration"},
    "source_truth": {"const": "NOT_EVALUATED"},
    "authority": {"const": "NOT_EVALUATED"},
    "admission": {"const": "NOT_EVALUATED"},
    "note": {"type": "string"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
